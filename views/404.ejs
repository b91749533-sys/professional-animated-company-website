<%- include('partials/header') %>

<section style="min-height: calc(80vh - var(--header-height)); display: flex; align-items: center; justify-content: center; text-align: center; padding: 6rem 2rem;">
  <div class="container" style="max-width: 500px;">
    <span class="section-tag" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(239, 68, 68, 0.04); color: #f87171;">Error 404</span>
    <h1 style="font-size: 3rem; margin-top: 1rem; margin-bottom: 1rem; font-weight: 800;">Page Not Found</h1>
    <p style="color: var(--text-muted); margin-bottom: 2.5rem;">
      The page you are looking for does not exist, has been moved, or is temporarily unavailable.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem;">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/contact" class="btn btn-secondary">Contact Support</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
