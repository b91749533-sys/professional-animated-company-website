<%- include('partials/header') %>

<!-- About Hero Section -->
<section style="padding: 10rem 2rem 5rem 2rem; background: radial-gradient(circle at 50% 30%, rgba(124, 58, 237, 0.06) 0%, transparent 60%); text-align: center;" class="reveal">
  <div class="container">
    <span class="section-tag">About Manssouri Tech</span>
    <h1 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 800;">Engineering the Digital Future</h1>
    <p style="max-width: 700px; margin: 0 auto 3rem auto; font-size: 1.2rem; color: var(--text-muted);">
      We are a team of tech architects, interface designers, and consultants building premium systems for enterprise-grade growth.
    </p>
  </div>
</section>

<!-- Company Story -->
<section class="reveal">
  <div class="container" style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center;">
    <div>
      <span class="section-tag">Our History</span>
      <h2 style="margin-top:0.5rem;">How It All Began</h2>
      <p>
        Founded with the goal of providing elite engineering capabilities to high-growth organizations, Manssouri Tech has evolved from a small design studio into an international consultancy. We realized that premium businesses were underserved by generic templates and slow, heavy frameworks.
      </p>
      <p>
        Our philosophy is simple: build for speed, design with clarity, and solve structural bottlenecks before they restrict growth. Every line of code we compile is tailored to enhance performance, guarantee uptime, and optimize Core Web Vitals.
      </p>
    </div>
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 3rem; border-radius: 16px; box-shadow: var(--shadow-md);">
      <h3 style="color: var(--text-accent); font-weight: 800; margin-bottom: 0.5rem;">Our Mission</h3>
      <p style="font-size: 1.05rem; line-height: 1.7; color: #fff; margin-bottom: 2rem;">
        "To empower companies to scale seamlessly by delivering high-fidelity digital products, cloud infrastructures, and intuitive user interfaces."
      </p>
      <h3 style="color: var(--color-purple); font-weight: 800; margin-bottom: 0.5rem;">Our Vision</h3>
      <p style="font-size: 1.05rem; line-height: 1.7; color: #fff; margin-bottom: 0;">
        "To be the premier global technology partner recognized for aesthetic precision, operational reliability, and client success."
      </p>
    </div>
  </div>
</section>

<!-- Core Values Grid -->
<section style="background: rgba(255, 255, 255, 0.01);" class="reveal">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Core Values</span>
      <h2>What Drives Us</h2>
      <p class="section-desc">These principles guide our design systems, database patterns, and daily client interactions.</p>
    </div>

    <div class="services-grid">
      <!-- Integrity -->
      <div class="service-card reveal reveal-delay-1">
        <div class="service-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">🛡️</div>
        <h3>Absolute Integrity</h3>
        <p>We build transparently, protect database privacy, prioritize SOC2 compliance guidelines, and tell clients the honest truth about scope.</p>
      </div>
      <!-- Aesthetic Precision -->
      <div class="service-card reveal reveal-delay-2">
        <div class="service-icon" style="background: rgba(124, 58, 237, 0.1); color: #a78bfa;">💎</div>
        <h3>Aesthetic Precision</h3>
        <p>UI spacing, typography hierarchies, contrast accessibility, and scroll frame curves must be pixel-perfect, down to the last element.</p>
      </div>
      <!-- Performance Obsessed -->
      <div class="service-card reveal reveal-delay-3">
        <div class="service-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">⚡</div>
        <h3>Performance Obsessed</h3>
        <p>Every millisecond saved is a conversion earned. We optimize static paths, cache dynamically, compress media, and audit rendering paths.</p>
      </div>
    </div>
  </div>
</section>

<!-- Historical Timeline Section -->
<section class="reveal">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Timeline</span>
      <h2>Our Journey</h2>
      <p class="section-desc">Key moments, expansions, and achievements along our engineering roadmap.</p>
    </div>

    <div class="timeline-container">
      <div class="timeline-line"></div>

      <!-- Item 1 -->
      <div class="timeline-item timeline-item-left reveal">
        <div class="timeline-node"></div>
        <div class="timeline-card">
          <div class="timeline-year">2023</div>
          <h4>Foundation & First Launch</h4>
          <p>Founded by Youssef Manssouri in London, offering dedicated custom React builds and high-performance site tuning services.</p>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="timeline-item timeline-item-right reveal">
        <div class="timeline-node"></div>
        <div class="timeline-card">
          <div class="timeline-year">2024</div>
          <h4>Scaling to Enterprise</h4>
          <p>Established key cloud architecture divisions, designing scalable Kubernetes arrays and high-speed telemetry dashboards.</p>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="timeline-item timeline-item-left reveal">
        <div class="timeline-node"></div>
        <div class="timeline-card">
          <div class="timeline-year">2025</div>
          <h4>Global Expansion</h4>
          <p>Incorporated remote talent hubs across US and Europe, surpassing 100 successfully delivered client products.</p>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="timeline-item timeline-item-right reveal">
        <div class="timeline-node"></div>
        <div class="timeline-card">
          <div class="timeline-year">2026</div>
          <h4>AI Integration Launch</h4>
          <p>Released Aether, our proprietary neural pipeline, enabling clients to integrate LLM routing directly into core systems.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
