<%- include('partials/header') %>

<!-- Blog Article Container -->
<article class="blog-detail-container">
  
  <!-- Article Header -->
  <header class="blog-detail-header reveal">
    <span class="blog-post-category"><%= post.category %></span>
    <h1 class="blog-post-title"><%= post.title %></h1>
    
    <div class="blog-post-meta">
      <span>Published: <strong><%= post.date %></strong></span>
      <span>Read Time: <strong><%= post.readTime %></strong></span>
      <span>Views: <strong><%= post.views || 0 %> views</strong></span>
    </div>
  </header>

  <!-- Main Visual Image -->
  <div class="blog-post-img reveal reveal-delay-1">
    <div style="width:100%; height:100%; background: linear-gradient(135deg, #0e1726 0%, #1e293b 100%); display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,0.1); font-weight:800; font-size:4rem;"><%= post.category %></div>
  </div>

  <!-- Body Content -->
  <div class="blog-post-body reveal reveal-delay-2">
    <%- post.content %>
  </div>

  <!-- Related navigation / Footer CTAs -->
  <div class="reveal" style="margin-top: 5rem; border-top: 1px solid var(--border-color); padding-top: 3rem; display: flex; justify-content: space-between; align-items: center;">
    <a href="/blog" class="btn btn-secondary">&larr; Back to Blog Feed</a>
    <div>
      <span style="font-size:0.85rem; color:var(--text-dim); margin-right:1rem;">Share this article:</span>
      <!-- Stub links -->
      <a href="https://linkedin.com" target="_blank" rel="noopener" style="color:var(--text-accent); font-weight:600; margin-right:1rem;">LinkedIn</a>
      <a href="https://twitter.com" target="_blank" rel="noopener" style="color:var(--text-accent); font-weight:600;">Twitter</a>
    </div>
  </div>

</article>

<%- include('partials/footer') %>
