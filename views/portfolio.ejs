<%- include('partials/header') %>

<!-- Portfolio Hero Section -->
<section style="padding: 10rem 2rem 5rem 2rem; background: radial-gradient(circle at 50% 30%, rgba(37, 99, 235, 0.06) 0%, transparent 60%); text-align: center;" class="reveal">
  <div class="container">
    <span class="section-tag">Case Studies</span>
    <h1 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 800;">Our Work</h1>
    <p style="max-width: 700px; margin: 0 auto 3rem auto; font-size: 1.2rem; color: var(--text-muted);">
      A collection of custom applications, visual identity designs, and high-performance backend pipelines built for global organizations.
    </p>
  </div>
</section>

<!-- Portfolio List Section -->
<section class="reveal" style="padding-top: 2rem;">
  <div class="container">
    
    <!-- Category Tabs -->
    <div class="portfolio-filters">
      <% categories.forEach(category => { %>
        <a href="/portfolio?category=<%= encodeURIComponent(category) %>" class="filter-tab <%= selectedCategory === category ? 'active' : '' %>">
          <%= category %>
        </a>
      <% }) %>
    </div>

    <!-- Grid List -->
    <div class="portfolio-grid">
      <% if (projects.length === 0) { %>
        <div style="grid-column: 1/-1; text-align: center; padding: 4rem 2rem; color: var(--text-muted);">
          <p style="font-size: 1.2rem;">No projects found in this category.</p>
          <a href="/portfolio" class="btn btn-secondary" style="margin-top: 1rem;">View All Projects</a>
        </div>
      <% } else { %>
        <% projects.forEach(project => { %>
          <div class="portfolio-card reveal">
            <div class="portfolio-img-wrapper">
              <!-- Overlay Content on Hover -->
              <div class="portfolio-overlay">
                <span class="portfolio-tag"><%= project.category %></span>
                <h3><%= project.title %></h3>
                <p><%= project.description %></p>
                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                  <a href="/portfolio/<%= project.slug %>" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.85rem;">Read Case Study</a>
                  <span style="font-size: 0.85rem; font-weight: 600; color: #fff;"><%= project.client %></span>
                </div>
              </div>
              <!-- Simulated Graphic Background -->
              <div style="width:100%; height:100%; background: linear-gradient(135deg, #101726 0%, #1e293b 100%);"></div>
            </div>
            <div class="portfolio-card-content">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
                <span class="portfolio-tag" style="margin:0;"><%= project.category %></span>
                <span style="font-size: 0.8rem; color: var(--text-dim); font-weight:500;"><%= project.date %></span>
              </div>
              <h3 style="margin-bottom: 0.5rem;"><%= project.title %></h3>
              <p style="font-size: 0.9rem; line-height: 1.5; color: var(--text-muted); margin-bottom: 1.5rem;"><%= project.description %></p>
              
              <div class="portfolio-tags">
                <% project.tags.forEach(tag => { %>
                  <span><%= tag %></span>
                <% }) %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
