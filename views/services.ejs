<%- include('partials/header') %>

<!-- Services Hero Section -->
<section style="padding: 10rem 2rem 5rem 2rem; background: radial-gradient(circle at 50% 30%, rgba(37, 99, 235, 0.06) 0%, transparent 60%); text-align: center;" class="reveal">
  <div class="container">
    <span class="section-tag">Our Capabilities</span>
    <h1 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 800;">Enterprise-Grade Capabilities</h1>
    <p style="max-width: 700px; margin: 0 auto 3rem auto; font-size: 1.2rem; color: var(--text-muted);">
      We offer full-cycle design, engineering, and consulting to transform systems, optimize latency, and fuel business growth.
    </p>
  </div>
</section>

<!-- Detailed Capability Cards -->
<section class="reveal">
  <div class="container">
    <div class="services-grid" style="grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem;">
      
      <!-- Web Development -->
      <div class="service-card reveal">
        <div class="service-icon">⚡</div>
        <h3>Web Development</h3>
        <p style="margin-bottom: 1.5rem;">
          We build custom, fast, and SEO-optimized web systems utilizing server-side rendering, API caching, static site generators, and edge networks.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• React, Node.js, Express engineering</li>
          <li>• Multi-page static/SSR integrations</li>
          <li>• Optimized database connection pipelines</li>
        </ul>
      </div>

      <!-- Mobile Applications -->
      <div class="service-card reveal">
        <div class="service-icon">📱</div>
        <h3>Mobile Applications</h3>
        <p style="margin-bottom: 1.5rem;">
          Cross-platform mobile apps for iOS and Android built on clean architectures with robust offline database support and device hardware hookups.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• Flutter & Native compilation</li>
          <li>• Offline SQL caching & syncing</li>
          <li>• Apple HealthKit & Wearables API hooks</li>
        </ul>
      </div>

      <!-- UI/UX Design -->
      <div class="service-card reveal">
        <div class="service-icon">🎨</div>
        <h3>UI/UX Design</h3>
        <p style="margin-bottom: 1.5rem;">
          Minimalist, high-end interfaces built from systematic component design tokens. Focusing on user retention, clarity, and access compliance.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• Figma component systems mapping</li>
          <li>• Interactive micro-animations</li>
          <li>• WCAG AAA Accessibility audits</li>
        </ul>
      </div>

      <!-- Cloud Solutions -->
      <div class="service-card reveal">
        <div class="service-icon">☁️</div>
        <h3>Cloud Solutions</h3>
        <p style="margin-bottom: 1.5rem;">
          Designing high-availability, self-healing cloud networks. Setting up auto-scaled Docker orchestration, CI/CD routines, and firewalls.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• Kubernetes & Terraform configuration</li>
          <li>• Edge CDN distribution & caching</li>
          <li>• SOC2 compliance architecture routing</li>
        </ul>
      </div>

      <!-- AI Integration -->
      <div class="service-card reveal">
        <div class="service-icon">🧠</div>
        <h3>AI Integration</h3>
        <p style="margin-bottom: 1.5rem;">
          Integrating customized machine learning layers, language processing prompts, vector RAG setups, and automated agent routing.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• Large Language Model (LLM) agents</li>
          <li>• Vector DB retrieval (Pinecone, Chroma)</li>
          <li>• Custom neural network predictions</li>
        </ul>
      </div>

      <!-- Digital Consulting -->
      <div class="service-card reveal">
        <div class="service-icon">📊</div>
        <h3>Digital Consulting</h3>
        <p style="margin-bottom: 1.5rem;">
          Helping leadership teams navigate tech debt, design product roadmaps, select stack options, and audit code bases for performance.
        </p>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">
          <li>• Product discovery workshops</li>
          <li>• Tech stack & debt optimization analysis</li>
          <li>• Team training & delivery sprints</li>
        </ul>
      </div>

    </div>
  </div>
</section>

<!-- Call To Action Section -->
<section style="background: linear-gradient(135deg, rgba(37,99,235,0.05) 0%, rgba(124,58,237,0.05) 100%); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);" class="reveal">
  <div class="container" style="text-align: center; max-width: 700px;">
    <h2 style="font-size: 2.25rem; margin-bottom: 1.5rem;">Ready to Build Something Exceptional?</h2>
    <p style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2.5rem;">
      Let's align on a plan to optimize your systems, refine your interface design, and achieve production reliability.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem;">
      <a href="/contact" class="btn btn-primary">Schedule a Call</a>
      <a href="/portfolio" class="btn btn-secondary">Review Our Work</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
