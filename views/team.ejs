<%- include('partials/header') %>

<!-- Team Hero Section -->
<section style="padding: 10rem 2rem 5rem 2rem; background: radial-gradient(circle at 50% 30%, rgba(124, 58, 237, 0.06) 0%, transparent 60%); text-align: center;" class="reveal">
  <div class="container">
    <span class="section-tag">Our Team</span>
    <h1 style="font-size: 3.5rem; margin-bottom: 1.5rem; font-weight: 800;">The Tech Architects</h1>
    <p style="max-width: 700px; margin: 0 auto 3rem auto; font-size: 1.2rem; color: var(--text-muted);">
      A global collective of software engineers, cloud architects, and product designers focused on digital quality.
    </p>
  </div>
</section>

<!-- Team Members Grid -->
<section class="reveal" style="padding-top: 2rem;">
  <div class="container">
    <div class="team-grid">
      <!-- Member 1 -->
      <div class="team-card reveal reveal-delay-1">
        <div class="team-img-wrapper">
          <!-- Mock profile background visual -->
          <div style="width:100%; height:100%; background: linear-gradient(135deg, #1e1b4b 0%, #311042 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:3rem;">YM</div>
        </div>
        <div class="team-info">
          <h3 class="team-name">Youssef Manssouri</h3>
          <div class="team-role">Founder &amp; Chief Architect</div>
          <p class="team-bio">Principal technologist setting system design architectures and leading digital delivery pipelines.</p>
          <div class="team-socials">
            <a href="https://github.com" target="_blank" rel="noopener" class="team-social-link">GitHub</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" class="team-social-link">LinkedIn</a>
          </div>
        </div>
      </div>

      <!-- Member 2 -->
      <div class="team-card reveal reveal-delay-2">
        <div class="team-img-wrapper">
          <div style="width:100%; height:100%; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:3rem;">SR</div>
        </div>
        <div class="team-info">
          <h3 class="team-name">Sarah Jenkins</h3>
          <div class="team-role">Lead UI/UX Designer</div>
          <p class="team-bio">Design system lead establishing minimalist guidelines, visual interfaces, and contrast rules.</p>
          <div class="team-socials">
            <a href="https://dribbble.com" target="_blank" rel="noopener" class="team-social-link">Dribbble</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" class="team-social-link">LinkedIn</a>
          </div>
        </div>
      </div>

      <!-- Member 3 -->
      <div class="team-card reveal reveal-delay-3">
        <div class="team-img-wrapper">
          <div style="width:100%; height:100%; background: linear-gradient(135deg, #111827 0%, #030712 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:3rem;">MK</div>
        </div>
        <div class="team-info">
          <h3 class="team-name">Marcus Kross</h3>
          <div class="team-role">Cloud Infrastructure Director</div>
          <p class="team-bio">DevOps specialist implementing Kubernetes server clustering and self-healing deployment scripts.</p>
          <div class="team-socials">
            <a href="https://github.com" target="_blank" rel="noopener" class="team-social-link">GitHub</a>
            <a href="https://linkedin.com" target="_blank" rel="noopener" class="team-social-link">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Company Culture teaser -->
<section style="background: rgba(255,255,255,0.01);" class="reveal">
  <div class="container" style="text-align: center; max-width: 650px;">
    <h2>Join the Innovation Hub</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">
      We are always looking for talented engineers and creative designers to push the boundaries of technology.
    </p>
    <a href="/careers" class="btn btn-primary">View Open Positions</a>
  </div>
</section>

<%- include('partials/footer') %>
